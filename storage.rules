rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read/write for authenticated users, ensuring file size is under 5MB and is an image type
      allow read, write: if request.auth != null
                         && (request.resource == null // Allow deletion
                         || (request.resource.size < 5 * 1024 * 1024
                         && request.resource.contentType.matches('image/.*')));
    }
  }
}
